# Copy to server/.env and fill in. Never commit the filled version — .env is gitignored.
# The real values for this deployment live in nirantara-credentials.txt, kept outside the repo.

NODE_ENV=production
PORT=4000
DATA_DIR=/opt/nirantara/server/data

# Encrypts every stored PAN and demat number (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This is the one value that cannot be regenerated. Restoring a database without
# the key it was written with leaves every PAN permanently unreadable — back it up
# separately from the .db file.
PAN_ENCRYPTION_KEY=

# Only these origins may call the API. Comma separated, no trailing slash.
CORS_ORIGINS=https://www.nirantara.cloud,https://nirantara.cloud

# Guards /api/admin/*. Those routes answer 404 rather than 401 when it is wrong,
# so they do not advertise their own existence.
ADMIN_TOKEN=

# Background jobs: IPO sync, GMP sync, the allotment watcher, lifecycle alerts.
# Exactly one server should have this on, or users get duplicate notifications.
ENABLE_JOBS=true

# Chromium is no longer required — every registrar that can be automated runs over
# plain HTTP. Only Cameo needs a browser, and it enforces a captcha, so a browser
# does not help it either.
ENABLE_BROWSER_REGISTRARS=false
BROWSER_HEADLESS=true

# Google Sign-In. Empty disables the endpoint rather than accepting unverifiable
# tokens. Must match VITE_GOOGLE_CLIENT_ID in the web build or every token is
# rejected on the audience check.
GOOGLE_CLIENT_ID=

# Browser push. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# A URL subject avoids publishing a personal address to push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://www.nirantara.cloud

# Mobile release gate. Builds below APP_MIN_VERSION are blocked at launch.
# It must only ever go UP: installs in the wild report their own version, and a
# lower scheme would compare as older, so nobody would ever be prompted.
APP_MIN_VERSION=1.0.1
APP_LATEST_VERSION=1.0.1
APP_DOWNLOAD_URL=https://www.nirantara.cloud/download
APP_UPDATE_MESSAGE=

# Transactional email. Empty credentials disable sending outright rather than
# failing per message. Gmail needs an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nirantara IPO <stack.nirantaraipo@gmail.com>
