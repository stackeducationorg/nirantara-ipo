# Copy to server/.env and adjust. Everything here has a working default except in production.

PORT=4000
DATA_DIR=./data

# REQUIRED IN PRODUCTION. 32 bytes, hex or base64. PANs are encrypted at rest with this key,
# so changing it makes existing rows unreadable. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAN_ENCRYPTION_KEY=

# Comma-separated origins allowed to call the API. Empty = allow all (fine for local dev).
# Set this in production, e.g. https://niranthar.in,https://www.niranthar.in
CORS_ORIGINS=

# Shared secret for the /api/admin/* job triggers. Leave blank to disable those routes.
# Send it as the x-admin-token header.
ADMIN_TOKEN=

# Background jobs. Set ENABLE_JOBS=false to run the API without the schedulers.
ENABLE_JOBS=true
IPO_SYNC_CRON=0 */2 * * *
GMP_SYNC_CRON=*/15 * * * *
ALLOTMENT_POLL_CRON=*/10 * * * *
LIFECYCLE_CRON=5 9,18 * * *

# KFin and MUFG sit behind bot protection and need a real browser (Playwright/Chromium).
# Set to false on hosts without Chromium — Bigshare and the other HTTP registrars still work.
ENABLE_BROWSER_REGISTRARS=true
BROWSER_HEADLESS=true

# Browser push for the website. Generate a pair with:
#   npx web-push generate-vapid-keys
# Leave blank to run without browser push (in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: only needed for Expo push at higher volume.
EXPO_ACCESS_TOKEN=
