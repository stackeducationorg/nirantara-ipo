{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.nirantara.cloud/api"
      }
    },
    "device": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.nirantara.cloud/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://api.nirantara.cloud/api",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "1063536050082-0od875oho71jong5vr46q324kc0jcllc.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
