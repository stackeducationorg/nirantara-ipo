{
  "name": "niranthar-ipo",
  "private": true,
  "version": "1.0.0",
  "description": "IPO tracker: GMP, details, auto allotment checking across all saved PANs, with push notifications",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev:mobile": "cd mobile && npm start",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "eas-cli": "^22.0.0",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
