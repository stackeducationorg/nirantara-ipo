node_modules/
dist/
*.tsbuildinfo
build/
.expo/
*.log

# Local database and secrets
server/data/
.env
.env.local

# OS noise
.DS_Store
Thumbs.db

# Expo prebuild output. `npx expo prebuild` regenerates these from app.config.js, so
# committing them would fork the native project away from the config that produces it.
mobile/android/
mobile/ios/

# Credential dumps must never be committed, wherever they land.
nirantara-credentials.txt
*credentials*.txt

# Belt-and-braces for secret material that does not carry "credentials" in its name.
# NOTE: PASSWORD.MD and google creds/ are ALREADY TRACKED in this repo's history, so these
# rules do not untrack them — they only stop new files of the same shape being added. Purging
# the existing ones needs a history rewrite plus rotation of the exposed OAuth client secret.
client_secret_*.json
google-services*.json
# ...but the Android one is committed and has to reach the builder. EAS filters its upload by
# these patterns rather than by what git tracks, so without this exception the build fails with
# "google-services.json is missing", and any APK that slipped through would carry no FCM config
# and no working push. It ships inside every APK anyway, so it is not secret material.
!mobile/google-services.json
