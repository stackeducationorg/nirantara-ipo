[Unit]
Description=Nirantara IPO API
Documentation=https://github.com/stackeducationorg/nirantara-ipo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nirantara
Group=nirantara
WorkingDirectory=/opt/nirantara/server
EnvironmentFile=/opt/nirantara/server/.env
ExecStart=/usr/bin/node dist/index.js

# The process handles SIGINT itself to close the database cleanly.
KillSignal=SIGINT
TimeoutStopSec=30

Restart=always
RestartSec=5

# Cap the unit so a runaway process gets restarted by systemd rather than the kernel picking
# a victim at random. Sized for the 12GB A1 box, with headroom left for nginx and the OS.
# On a 1GB micro, drop these to MemoryMax=820M / MemoryHigh=700M.
MemoryMax=10G
MemoryHigh=9G

# Hardening: the service needs nothing outside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nirantara/server/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nirantara-api

[Install]
WantedBy=multi-user.target
